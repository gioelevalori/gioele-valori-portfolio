{
  "version": 1,
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": "src/index.html",
            "styles": [
              "src/styles.css",
              "src/demo.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "outputPath": "dist/portfolio",
            "optimization": {
              "fonts": false,
              "scripts": true,
              "styles": true
            },
            "outputHashing": "all",
            "server": "src/main.server.ts",
            "outputMode": "static"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "portfolio:build"
          }
        }
      }
    }
  }
}
